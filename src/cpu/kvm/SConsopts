Import('*')

from gem5_scons import error, warning

import gem5_scons
import os

# ISA code can set this to indicate what ISA KVM can target.
main['CONF'].setdefault('KVM_ISA', '')

# There are two implementations of the KVM API to choose from, and a build may
# contain either, both, or -- if nothing below works out -- neither.  Which one
# a simulation uses is a runtime choice, KvmVM.qemu.
#
# Probe the host kernel's first, while the compiler's include path is still
# the plain host one.  QVM ships its own copy of <linux/kvm.h> for hosts that
# have none, and adding that to the search path before this point would make
# the check below answer a question nobody asked.
with gem5_scons.Configure(main) as conf:
    # Set these through conf.env, not main: leaving a Configure block replaces
    # the environment with the clone the block worked on, so anything written
    # straight to main in here is thrown away.
    conf.env['CONF']['USE_HOST_KVM'] = False
    conf.env['CONF'].setdefault('HAVE_PERF_ATTR_EXCLUDE_HOST', False)

    # Two host facilities the KVM CPUs use that are not part of the KVM API,
    # and that a host may lack independently of it.  perf_event counts the
    # guest's cycles and instructions; POSIX timers bound each guest run.
    # Neither exists on macOS, so both have stand-ins (see perfevent.hh and
    # ThreadKvmTimer) and are reported here so the code can pick.
    conf.env['CONF']['USE_PERF_EVENT'] = bool(conf.CheckHeader(
        'linux/perf_event.h', '<>'))
    if not conf.env['CONF']['USE_PERF_EVENT']:
        warning("Info: no perf_event on this host. KVM CPUs will need "
                "BaseKvmCPU.usePerf=False, and will not report cycle or "
                "instruction counts.")

    conf.env['CONF']['HAVE_POSIX_TIMERS'] = bool(conf.CheckLibWithHeader(
        [None, 'rt'], ['time.h', 'signal.h'], 'C',
        call='timer_create(CLOCK_MONOTONIC, NULL, NULL);'))
    if not conf.env['CONF']['HAVE_POSIX_TIMERS']:
        warning("Info: no POSIX timers on this host; KVM CPUs will bound "
                "guest runs with a helper thread instead.")

    # The API we rely on exists since version 2.6.36 of the kernel, but
    # somehow the KVM_API_VERSION does not reflect the change. We test
    # for one of the types as a fall back.
    if not conf.CheckHeader('linux/kvm.h', '<>'):
        warning("Info: <linux/kvm.h> not found; the host KVM backend is "
                "unavailable.")
    else:
        # Generic support is available. We'll let the ISAs figure out if
        # it's really supported.
        conf.env['CONF']['USE_HOST_KVM'] = True

        # Check if the exclude_host attribute is available. We want this to
        # get accurate instruction counts in KVM.
        conf.env['CONF']['HAVE_PERF_ATTR_EXCLUDE_HOST'] = conf.CheckMember(
            'linux/perf_event.h', 'struct perf_event_attr', 'exclude_host')

        # Warn about missing optional functionality
        if not conf.env['CONF']['HAVE_PERF_ATTR_EXCLUDE_HOST']:
            warning("perf_event headers lack support for the exclude_host "
                    "attribute. KVM instruction counts will be inaccurate.")

# QVM (<qemu>/qvm) implements the same API in userspace on top of QEMU's
# system-mode TCG, which lifts both of KVM's usual requirements: the host does
# not have to be Linux, and its ISA does not have to match the simulated one.
# QVM_PATH points at a configured QEMU source tree; without it, <qvm/qvm.h> is
# still looked for in the default places, so an installed libqvm is picked up
# on its own.
qvm_path = os.environ.get('QVM_PATH')
if qvm_path:
    qvm_build = os.environ.get('QVM_BUILD', os.path.join(qvm_path, 'build'))
    main.Append(CPPPATH=[os.path.join(qvm_path, 'include')])
    # QVM's KVM UAPI headers, and the handful of kernel definitions they rest
    # on, for hosts that ship none.  They also take precedence over the host's
    # on a Linux host, which is what makes the structures gem5 uses describe
    # the ISA being simulated rather than the one it is running on.
    # QVM_ISA names the guest that libqvm was built for; its directory comes
    # first, because it is what decides which architecture's KVM ABI
    # <asm/kvm.h> describes.  That is the guest's, which need have nothing to
    # do with the machine this is running on.
    qvm_isa = os.environ.get('QVM_ISA', 'x86')
    main.Append(CCFLAGS=[
        '-isystem', os.path.join(qvm_path, 'qvm', 'linux-compat-' + qvm_isa),
        '-isystem', os.path.join(qvm_path, 'qvm', 'linux-compat'),
        '-isystem', os.path.join(qvm_path, 'linux-headers'),
    ])
    main.Append(LIBPATH=[qvm_build])
    # Spell the rpath out rather than using SCons's RPATH: its Darwin link
    # tool drops that, and the binary then cannot find libqvm at run time.
    main.Append(LINKFLAGS=['-Wl,-rpath,' + os.path.abspath(qvm_build)])

with gem5_scons.Configure(main) as conf:
    # CheckLibWithHeader adds -lqvm to LIBS only if this succeeds, so a failed
    # probe leaves the link line alone.
    conf.env['CONF']['USE_QVM'] = bool(conf.CheckLibWithHeader(
        'qvm', 'qvm/qvm.h', 'C', call='qvm_open("/dev/kvm", 0);'))

    if not conf.env['CONF']['USE_QVM'] and qvm_path:
        warning("QVM_PATH is set to %s but libqvm could not be used from "
                "there. Has QEMU been configured and libqvm built?" % qvm_path)

# The KVM CPUs are worth building if either backend can be.
main['CONF']['HAVE_KVM'] = (main['CONF'].get('USE_HOST_KVM', False) or
                            main['CONF'].get('USE_QVM', False))

def set_kvm_abi_vars():
    # Which ISA's KVM ABI this build compiles against.  KVM_ISA already knows,
    # from the host for the kernel's KVM and from QVM_ISA for QVM, so the C++
    # side never has to infer it from the machine it happens to be built on.
    isa = main['CONF']['KVM_ISA']
    main['CONF']['KVM_ABI_X86'] = (isa == 'x86')
    main['CONF']['KVM_ABI_ARM'] = (isa == 'arm')
    main['CONF']['KVM_ABI_RISCV'] = (isa == 'riscv')

def create_use_kvm_var():
    if not main['CONF']['HAVE_KVM']:
        # The ISA SConsopts claim KVM_ISA from QVM_PATH alone, because they run
        # before the probe below has an answer.  Withdraw the claim if nothing
        # came of it, rather than leave a build that thinks it can simulate an
        # ISA it has no KVM API for.
        main['CONF']['KVM_ISA'] = ''

    if main['CONF'].get('USE_KVM') and not main['CONF']['HAVE_KVM']:
        # Kconfig should have made this unreachable; if it ever is reached,
        # say so here rather than in a wall of compiler errors.
        error("KVM CPUs are enabled but there is no KVM API to build them "
              "against.")

    if main['CONF']['HAVE_KVM'] and not main['CONF']['KVM_ISA']:
        warning("Cannot enable KVM: no simulated ISA can use the available "
                "KVM API on this host.")

    if not main['CONF']['HAVE_KVM']:
        warning("Cannot enable KVM: neither the host kernel's /dev/kvm nor "
                "QVM is usable here.\n"
                "  - host KVM needs <linux/kvm.h>, so it is Linux-only.\n"
                "  - QVM needs <qvm/qvm.h> and libqvm; set QVM_PATH to a "
                "configured QEMU source tree that has had 'ninja libqvm' run "
                "in it.\n"
                "  QVM is the one that works on hosts KVM does not, including "
                "Apple silicon.")

AfterSConsopts(create_use_kvm_var)
AfterSConsopts(set_kvm_abi_vars)
